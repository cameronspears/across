{"html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>File transfer</title>\n<link rel=\"icon\" href=\"data:,\">\n<style>\nbody{max-width:36em;margin:2em auto;padding:0 1em;font:17px/1.5 Georgia,serif}\nh1{font-size:1.4em;font-weight:normal;margin:0 0 1em}\nsmall{color:GrayText}\na{overflow-wrap:anywhere}\n</style>\n</head>\n<body>\n<h1>File transfer</h1>\n\n<p id=\"pick\" hidden><input type=\"file\" id=\"file\"><br>\n<small>Encrypted from your browser to theirs. No size limit.</small></p>\n\n<div id=\"send\" hidden>\n<p>Sending <b id=\"s-name\"></b> (<span id=\"s-size\"></span>)</p>\n<p>Link:<br><a id=\"link\" target=\"_blank\"></a> <button id=\"copy\">Copy</button><br>\n<small>Keep this tab open until the download finishes.</small></p>\n<div id=\"xfers\"></div>\n</div>\n\n<div id=\"recv\" hidden>\n<p><b id=\"r-name\">Connecting…</b> <span id=\"r-size\"></span></p>\n<p><button id=\"go\" hidden>Download</button></p>\n<div id=\"r-xfer\"></div>\n</div>\n\n<p id=\"privacy\" hidden><label><input type=\"checkbox\" id=\"hide\"> Hide my IP address</label><br>\n<small id=\"hide-note\"></small></p>\n\n<p id=\"msg\"></p>\n\n<script>\n'use strict';\nconst STUN = ['stun:stun.cloudflare.com:3478', 'stun:stun.l.google.com:19302'];\nconst BLOCK = 8 << 20;     // file read size; next block is read while this one sends\nconst CHUNK = 256 << 10;   // per data-channel message (capped by what the peer allows)\nconst HIGH = 4 << 20, LOW = 1 << 20;\nconst GATHER_MS = 1500;    // send the SDP by then if it has a relay candidate\nconst GATHER_MAX_MS = 5000; // and by then regardless\nconst RELAY_REUSE_MS = 3_600_000; // credentials last 8 hours, so a connection made with them has at least 7\nconst RELAY_RETRY_MS = 30_000;\nconst HELLO_MS = 8000, HELLOS = 15;\nconst PROVE_MS = 20000, UNPROVEN = 8;\nconst RID = /^[a-z0-9]{16}$/;\n\nconst $ = (s) => document.querySelector(s);\nconst enc = new TextEncoder();\nconst hex = (b) => Array.from(new Uint8Array(b), (x) => x.toString(16).padStart(2, '0')).join('');\nconst say = (t) => ($('#msg').textContent = t);\nconst sleep = (ms) => new Promise((ok) => setTimeout(ok, ms));\n\nfunction rid(n) {\n  const abc = 'abcdefghijkmnpqrstuvwxyz23456789';\n  return Array.from(crypto.getRandomValues(new Uint8Array(n)), (b) => abc[b & 31]).join('');\n}\n\nfunction size(n) {\n  const u = ['B', 'KB', 'MB', 'GB', 'TB'];\n  let i = 0;\n  while (n >= 1000 && i < 4) { n /= 1000; i++; }\n  return (i ? n.toFixed(n < 10 ? 1 : 0) : n) + u[i];\n}\n\n// ---- trust: the server only ever sees hash(secret), never the secret ----\n\nasync function roomOf(secret) {\n  return hex(await crypto.subtle.digest('SHA-256', enc.encode('et-room|' + secret))).slice(0, 32);\n}\n\n// Proves knowledge of the secret, bound to this exact DTLS connection's\n// certificates. A server relaying two separate connections (a middleman) would\n// see different fingerprints on each side, so its proofs can't match.\nasync function proof(secret, role, pc, local) {\n  const fp = (d) => d.sdp.match(/^a=fingerprint:\\S+ (\\S+)/m)[1].toUpperCase();\n  const mine = fp(pc.localDescription), theirs = fp(pc.remoteDescription);\n  const [s, r] = local === 's' ? [mine, theirs] : [theirs, mine];\n  const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);\n  return hex(await crypto.subtle.sign('HMAC', key, enc.encode(`et1|${role}|${s}|${r}`)));\n}\n\n// ---- signaling: each browser long-polls its own mailbox on the server ----\n\n// Who may send each handshake message. The server is untrusted, so anything else is dropped.\nconst SIGNALS = { hello: { from: 'r', sdp: false }, offer: { from: 's', sdp: true }, answer: { from: 'r', sdp: true } };\n\nfunction parseSignal(env) {\n  const t = env?.data?.t;\n  const kind = Object.hasOwn(SIGNALS, t) && SIGNALS[t];\n  if (!kind || (kind.from === 's' ? env.from !== 's' : !RID.test(env.from))) return null;\n  if (!kind.sdp) return { from: env.from, t };\n  const d = env.data.sdp;\n  return d?.type === t && typeof d.sdp === 'string' ? { from: env.from, t, sdp: { type: t, sdp: d.sdp } } : null;\n}\n\nfunction signaling(room, me, onSignal) {\n  const ctl = new AbortController();\n  addEventListener('pagehide', () => ctl.abort());\n  (async () => {\n    for (let wait = 1000; !ctl.signal.aborted;) {\n      try {\n        const r = await fetch(`api/signal?room=${room}&me=${me}`, { signal: ctl.signal });\n        if (!r.ok) throw new Error(`HTTP ${r.status}`);\n        const list = await r.json();\n        if (ctl.signal.aborted) return;\n        for (const env of Array.isArray(list) ? list : []) {\n          const m = parseSignal(env);\n          if (m) onSignal(m);\n        }\n        wait = 1000;\n      } catch {\n        if (ctl.signal.aborted) return;\n        await sleep(wait);\n        wait = Math.min(wait * 2, 10_000);\n      }\n    }\n  })();\n  return {\n    post: (to, data) => fetch('api/signal', { method: 'POST', body: JSON.stringify({ room, from: me, to, data }) }).catch(() => {}),\n    stop: () => ctl.abort(),\n  };\n}\n\n// ---- privacy: each browser alone decides whether the other side may learn its IP address ----\n\nconst RELAY_DOWN = 'The private relay is unavailable right now. To connect directly, untick Hide my IP address. ' +\n  'The other person will then see your IP address.';\nconst NO_RELAY = 'no relay';\nconst note = () => ($('#hide-note').textContent = hide\n  ? \"The connection goes through an encrypted relay that can't read the file. The other person sees the relay's address, not yours.\"\n  : 'The other person can see your IP address. A direct connection is often faster.');\n\nlet hide = true;\ntry { hide = localStorage.getItem('hide-ip') !== '0'; } catch {}\n\nfunction privacyBox(onChange) {\n  const box = $('#hide');\n  box.checked = hide;\n  note();\n  $('#privacy').hidden = false;\n  box.onchange = () => {\n    hide = box.checked;\n    note();\n    try { localStorage.setItem('hide-ip', hide ? '1' : '0'); } catch {}\n    onChange();\n  };\n}\n\nconst turnServers = (list) => (Array.isArray(list) ? list : []).flatMap((s) => {\n  const urls = [s?.urls].flat().filter((u) => typeof u === 'string' && /^turns?:/.test(u) && !/:53(\\?|$)/.test(u));\n  return urls.length && typeof s.username === 'string' && typeof s.credential === 'string'\n    ? [{ urls, username: s.username, credential: s.credential }] : [];\n});\n\n// TURN servers from /api/ice, or [] while the relay is unavailable.\nlet relay = { at: -Infinity, servers: [] };\nfunction relayServers() {\n  if (Date.now() - relay.at < (relay.servers.length ? RELAY_REUSE_MS : RELAY_RETRY_MS)) return relay.servers;\n  return (relay.pending ??= fetch('api/ice', { cache: 'no-store' })\n    .then((r) => (r.ok ? r.json() : null))\n    .then((body) => turnServers(body?.iceServers), () => [])\n    .then((servers) => (relay = { at: Date.now(), servers }).servers));\n}\n\nlet relay2;\nconst relayServers2 = () => (relay2 ??= fetch('api/ice?n=2', { cache: 'no-store' })\n  .then((r) => (r.ok ? r.json() : null))\n  .then((body) => turnServers(body?.iceServers), () => []));\n\n// Hidden: relay candidates only, so nothing this browser sends carries its address.\n// Shown: direct when possible, with the relay for networks where direct fails.\n// null: hidden, and there is no relay to hide behind.\nasync function rtcConfig(hidden) {\n  const turn = await relayServers();\n  if (hidden) return turn.length ? { iceTransportPolicy: 'relay', iceServers: turn } : null;\n  return { iceTransportPolicy: 'all', iceServers: [{ urls: STUN }, ...turn] };\n}\n\n// The browser's relay-only policy is the guarantee; this refuses to send anything else in case\n// it fails, and blanks the related address, which some browsers fill with the local one.\nfunction relayOnly(sdp) {\n  const lines = sdp.split('\\r\\n').map((line) => {\n    if (!line.startsWith('a=candidate:')) return line;\n    const f = line.split(' ');\n    if (f[6] !== 'typ' || f[7] !== 'relay') throw new Error(NO_RELAY);\n    const at = f.indexOf('raddr');\n    if (at > 0) f.splice(at, 4, 'raddr', '0.0.0.0', 'rport', '0');\n    return f.join(' ');\n  });\n  if (!lines.some((l) => l.startsWith('a=candidate:'))) throw new Error(NO_RELAY);\n  return lines.join('\\r\\n');\n}\n\n// Non-trickle ICE: the SDP carries every candidate, so a handshake is three messages.\n// Waits for a relay candidate when there is a relay, since it is what rescues blocked networks.\nasync function describe(pc) {\n  await pc.setLocalDescription();\n  const { iceTransportPolicy, iceServers = [] } = pc.getConfiguration();\n  const turn = iceServers.some((s) => [s.urls].flat().some((u) => /^turns?:/.test(u)));\n  await new Promise((ok) => {\n    let late = false;\n    const check = () => (pc.iceGatheringState === 'complete' ||\n      (late && (!turn || pc.localDescription.sdp.includes(' typ relay')))) && ok();\n    pc.addEventListener('icecandidate', check);\n    pc.addEventListener('icegatheringstatechange', check);\n    setTimeout(() => { late = true; check(); }, GATHER_MS);\n    setTimeout(ok, GATHER_MAX_MS);\n    check();\n  });\n  const { type, sdp } = pc.localDescription;\n  return { type, sdp: iceTransportPolicy === 'relay' ? relayOnly(sdp) : sdp };\n}\n\n// ---- data channel control messages; the other browser is untrusted too ----\n\n// A name can carry controls that disguise it: U+202E shows \"invoice\\u202Efdp.exe\" as \"invoiceexe.pdf\".\nfunction cleanName(name) {\n  const clean = name.replace(/[\\u0000-\\u001f\\u007f-\\u009f\\u061c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]/g, '')\n    .replace(/[\\/\\\\]/g, '_').trim();\n  return Array.from(clean).slice(0, 255).join('') || 'file';\n}\n\nconst CONTROLS = {\n  hi: (m) => typeof m.p === 'string' && { t: 'hi', p: m.p },\n  meta: (m) => typeof m.name === 'string' && Number.isSafeInteger(m.size) && m.size >= 0 &&\n    { t: 'meta', name: cleanName(m.name), size: m.size },\n  start: () => ({ t: 'start' }),\n  cancel: () => ({ t: 'cancel' }),\n  done: () => ({ t: 'done' }),\n  got: () => ({ t: 'got' }),\n  offer2: (m) => m.sdp?.type && typeof m.sdp.sdp === 'string' && { t: m.t, sdp: { type: m.sdp.type, sdp: m.sdp.sdp } },\n  answer2: (m) => m.sdp?.type && typeof m.sdp.sdp === 'string' && { t: m.t, sdp: { type: m.sdp.type, sdp: m.sdp.sdp } },\n  lanes: (m) => (m.n === 1 || m.n === 2) && { t: 'lanes', n: m.n },\n};\n\nfunction parseControl(data, allowed) {\n  let m;\n  try { m = JSON.parse(data); } catch { return null; }\n  return (allowed.includes(m?.t) && CONTROLS[m.t](m)) || null;\n}\n\n// a progress bar made of text\nconst CELLS = 24;\nfunction view(parent) {\n  const label = document.createElement('small'), bar = document.createElement('code'), stats = document.createElement('span');\n  const el = document.createElement('p');\n  el.append(label, document.createElement('br'), bar, document.createElement('br'), stats);\n  parent.append(el);\n  let samples = [];\n  return {\n    label: (t) => (label.textContent = t),\n    remove: () => el.remove(),\n    set(n, total) {\n      const now = performance.now();\n      samples.push([now, n]);\n      while (samples.length > 2 && now - samples[0][0] > 2000) samples.shift();\n      const [t0, n0] = samples[0];\n      const bps = now > t0 ? ((n - n0) * 1000) / (now - t0) : 0;\n      const full = total ? Math.floor((n / total) * CELLS) : CELLS;\n      bar.textContent = Array.from({ length: CELLS }, (_, i) =>\n        i < full ? '█' : '░').join('');\n      stats.textContent = n >= total ? `${size(total)}, done` : `${Math.floor((n / total) * 100)}% ${size(n)}/${size(total)}${bps ? ` (${size(bps)}/s)` : ''}`;\n    },\n  };\n}\n\n// ================= sender =================\n\nfunction pickFile() {\n  $('#pick').hidden = false;\n  privacyBox(() => {});\n  $('#file').onchange = (e) => e.target.files[0] && send(e.target.files[0]);\n  // dropping a file anywhere on the page works too\n  addEventListener('dragover', (e) => e.preventDefault());\n  addEventListener('drop', (e) => {\n    e.preventDefault();\n    if (!$('#pick').hidden && e.dataTransfer.files[0]) send(e.dataTransfer.files[0]);\n  });\n}\n\nasync function send(file) {\n  $('#pick').hidden = true;\n  $('#send').hidden = false;\n  $('#s-name').textContent = file.name;\n  $('#s-size').textContent = size(file.size);\n  addEventListener('beforeunload', (e) => e.preventDefault());\n\n  const secret = rid(20);\n  const link = `${location.origin}${location.pathname}#${secret}`;\n  $('#link').href = $('#link').textContent = link;\n  $('#copy').onclick = () => navigator.clipboard.writeText(link).then(() => {\n    $('#copy').textContent = 'Copied';\n    setTimeout(() => ($('#copy').textContent = 'Copy'), 1200);\n  });\n  say('Waiting for the other side to open the link…');\n\n  // receiver id -> { id, pc, state, offer, timer }\n  // state: offering -> offered -> connecting -> verified, or closed.\n  // blocked: hidden and the relay is unavailable, so nothing was created or sent.\n  const peers = new Map();\n  const unproven = () => [...peers.values()].filter((p) => p.state !== 'verified').length;\n  const sig = signaling(await roomOf(secret), 's', (m) => {\n    const p = peers.get(m.from);\n    if (m.t === 'hello' && !p && unproven() < UNPROVEN) connect(m.from);\n    else if (m.t === 'hello' && p?.state === 'offered') sig.post(m.from, { t: 'offer', sdp: p.offer });\n    else if (m.t === 'answer' && p?.state === 'offered' && p.pc.signalingState === 'have-local-offer') {\n      p.state = 'connecting';\n      p.pc.setRemoteDescription(m.sdp).catch(() => drop(p));\n    }\n  });\n\n  // Peers that haven't exchanged descriptions yet start over with the new choice. The rest\n  // keep theirs: the other side already has those addresses.\n  privacyBox(() => {\n    for (const p of [...peers.values()]) {\n      if (p.state === 'offering' || p.state === 'offered' || p.state === 'blocked') {\n        drop(p);\n        connect(p.id);\n      }\n    }\n    status();\n  });\n  status();\n\n  async function status() {\n    const blocked = !(await rtcConfig(hide));\n    const idle = ![...peers.values()].some((p) => p.state === 'verified');\n    say(blocked ? RELAY_DOWN : idle ? 'Waiting for the other side to open the link…' : '');\n  }\n\n  function drop(p) {\n    p.state = 'closed';\n    clearTimeout(p.timer);\n    p.pc?.close();\n    p.pc2?.close();\n    if (peers.get(p.id) === p) peers.delete(p.id);\n  }\n\n  async function connect(id) {\n    const p = { id, state: 'offering' };\n    peers.set(id, p);\n    p.timer = setTimeout(() => drop(p), PROVE_MS);\n    const config = await rtcConfig(hide);\n    if (p.state !== 'offering') return;\n    if (!config) {\n      p.state = 'blocked';\n      return say(RELAY_DOWN);\n    }\n    const pc = (p.pc = new RTCPeerConnection(config));\n    const dc = pc.createDataChannel('f');\n    dc.binaryType = 'arraybuffer';\n    dc.bufferedAmountLowThreshold = LOW;\n    let row, started = false, finished = false;\n\n    dc.onopen = async () => dc.send(JSON.stringify({ t: 'hi', p: await proof(secret, 's', pc, 's') }));\n    let queue = Promise.resolve();\n    dc.onmessage = (e) => {\n      const m = parseControl(e.data, ['hi', 'start', 'cancel', 'got', 'answer2']);\n      if (!m) return drop(p);\n      queue = queue.then(() => onControl(m)).catch(() => drop(p));\n    };\n    dc.onclose = () => {\n      drop(p);\n      if (!row || finished) return;\n      if (started) return row.label('Disconnected.');\n      // they left before pressing Download, or reconnected to change their privacy setting\n      row.remove();\n      status();\n    };\n\n    async function onControl(m) {\n      if (p.state !== 'verified') {\n        // nothing is accepted before the proof\n        if (m.t !== 'hi' || m.p !== await proof(secret, 'r', pc, 's')) return drop(p);\n        clearTimeout(p.timer);\n        p.state = 'verified';\n        say('');\n        row = view($('#xfers'));\n        row.label('Connected. Waiting for them to press Download.');\n        row.set(0, file.size);\n        dc.send(JSON.stringify({ t: 'meta', name: file.name, size: file.size }));\n        if (hide) second();\n        else p.second = Promise.resolve(false);\n      } else if (m.t === 'answer2' && p.pc2 && !p.dc2) {\n        p.pc2.setRemoteDescription(m.sdp).catch(() => {});\n      } else if (m.t === 'start' && !started) {\n        started = true;\n        row.label('Sending');\n        // progress is measured here, not reported back: traffic flowing the\n        // other way mid-transfer makes Chrome's data channels stall for ~20s\n        const sent = { n: 0 };\n        const tick = setInterval(() => !finished && row.set(Math.max(0, sent.n - dc.bufferedAmount - (p.dc2?.bufferedAmount ?? 0)), file.size), 300);\n        Promise.race([p.second, sleep(6000)])\n          .then(() => pump(p.dc2 ? [dc, p.dc2] : [dc], file, Math.min(CHUNK, pc.sctp?.maxMessageSize || CHUNK), sent))\n          .catch(() => !finished && row.label('Stopped.'))\n          .finally(() => !finished && clearInterval(tick));\n        dc.addEventListener('close', () => clearInterval(tick));\n      } else if (m.t === 'got') {\n        finished = true;\n        row.set(file.size, file.size);\n        row.label('Received.');\n      } else if (m.t === 'cancel') {\n        finished = true;\n        row.label('Cancelled by the receiver.');\n      }\n    }\n\n\n    // resolves when the second link opens, or false\n    function second() {\n      p.second = (async () => {\n        const turn = await relayServers2();\n        if (!turn.length || p.state === 'closed') return false;\n        const pc2 = (p.pc2 = new RTCPeerConnection({ iceTransportPolicy: 'relay', iceServers: turn }));\n        const ch = pc2.createDataChannel('f2');\n        ch.binaryType = 'arraybuffer';\n        ch.bufferedAmountLowThreshold = LOW;\n        const open = new Promise((ok) => { ch.onopen = () => ok(true); ch.onclose = () => ok(false); });\n        dc.send(JSON.stringify({ t: 'offer2', sdp: await describe(pc2) }));\n        if (await open) p.dc2 = ch;\n        return !!p.dc2;\n      })().catch(() => false);\n    }\n\n    describe(pc).then((offer) => {\n      if (p.state !== 'offering') return;\n      p.offer = offer;\n      p.state = 'offered';\n      sig.post(id, { t: 'offer', sdp: offer });\n    }, (err) => {\n      if (p.state !== 'offering') return;\n      drop(p);\n      if (err.message === NO_RELAY) say(RELAY_DOWN);\n    });\n  }\n}\n\nasync function pump(lanes, file, chunk, sent) {\n  const read = (at) => file.slice(at, at + BLOCK).arrayBuffer();\n  let off = 0, next = read(0), k = 0;\n  lanes[0].send(JSON.stringify({ t: 'lanes', n: lanes.length }));\n  while (off < file.size) {\n    const buf = new Uint8Array(await next);\n    const end = off + buf.length;\n    next = end < file.size ? read(end) : null;\n    for (let i = 0; i < buf.length; i += chunk) {\n      const dc = lanes[k++ % lanes.length];\n      if (dc.bufferedAmount > HIGH) await drained(dc);\n      dc.send(buf.subarray(i, i + chunk));\n      sent.n += Math.min(chunk, buf.length - i);\n    }\n    off = end;\n  }\n  lanes[0].send(JSON.stringify({ t: 'done' }));\n}\n\nfunction drained(dc) {\n  return new Promise((ok, fail) => {\n    const off = () => { dc.onbufferedamountlow = null; dc.removeEventListener('close', bad); };\n    const bad = () => { off(); fail(); };\n    dc.onbufferedamountlow = () => { off(); ok(); };\n    dc.addEventListener('close', bad);\n  });\n}\n\n// ================= receiver =================\n\nlet swReady = Promise.resolve(null);\n\n// Every sink: write(ArrayBuffer) sync and ordered, close() -> Promise<url?>, abort().\nasync function openSink(meta, onCancel) {\n  // a fast click can beat the worker's first startup; give it a moment\n  const sw = await Promise.race([swReady, new Promise((ok) => setTimeout(ok, 1500, null))]);\n  const mode = new URLSearchParams(location.search).get('sink') ||\n    (sw && !/iP(hone|ad|od)|^((?!chrome|android|crios|fxios|edg).)*safari/i.test(navigator.userAgent) ? 'sw'\n      : 'showSaveFilePicker' in window ? 'fs' : 'mem');\n\n  if (mode === 'sw') {\n    // stream straight into a normal browser download\n    const id = rid(20);\n    const { port1, port2 } = new MessageChannel();\n    await new Promise((ok) => {\n      port1.onmessage = (e) => (e.data === 'ready' ? ok() : e.data === 'cancel' && onCancel());\n      sw.postMessage({ type: 'register', id, name: meta.name, size: meta.size }, [port2]);\n    });\n    const frame = document.createElement('iframe');\n    frame.hidden = true;\n    frame.src = `dl/${id}/${encodeURIComponent(meta.name)}`;\n    document.body.append(frame);\n    const ping = setInterval(() => sw.postMessage({ type: 'ping' }), 10_000); // Firefox reaps idle workers\n    const stop = () => { clearInterval(ping); setTimeout(() => frame.remove(), 60_000); };\n    return {\n      write: (ab) => port1.postMessage(ab, [ab]),\n      close: async () => { port1.postMessage('end'); stop(); },\n      abort: () => { port1.postMessage('abort'); stop(); },\n    };\n  }\n  if (mode === 'fs') {\n    const handle = await showSaveFilePicker({ suggestedName: meta.name });\n    // some contexts (embedded browsers, private windows, protected folders)\n    // show the picker but refuse writing; fall back to memory then\n    const w = await handle.createWritable().catch(() => null);\n    if (w) {\n      let q = Promise.resolve();\n      return {\n        write: (ab) => (q = q.then(() => w.write(ab))),\n        close: async () => { await q; await w.close(); },\n        abort: () => w.abort().catch(() => {}),\n      };\n    }\n  }\n  let parts = [];\n  return {\n    write: (ab) => parts.push(ab),\n    // never the sender's MIME type: a text/html blob would open as a page on this origin\n    close: async () => URL.createObjectURL(new Blob(p